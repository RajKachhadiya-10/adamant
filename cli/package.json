{
  "name": "@adamant/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.4.0"
  },
  "bin": {
    "adamant": "./src/index.tsx"
  },
  "scripts": {
    "start": "node --experimental-ffi --import tsx src/index.tsx",
    "build": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@adamant/contract": "workspace:*",
    "@opentui/core": "^0.6.1",
    "@opentui/react": "^0.6.1",
    "cli-spinners": "^3.4.0",
    "react": "^19.2.4",
    "tsx": "^4.23.15",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/ws": "^8.18.1"
  }
}
