DATABASE_URL=postgres://adamant:adamant@localhost:5432/adamant

# Worker only. Do not put this key in the API or Electron. The terminal reads its
# own copy from OPENAI_API_KEY in your shell or ~/.adamant/openai_key, not from here.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6

# API only. GitHub signs every delivery with this; a bad HMAC is a 401.
GITHUB_WEBHOOK_SECRET=

# Worker only. The agent mints an installation token per call from these and
# stores it nowhere. Paste the PEM with real newlines or as \n escapes.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
# API only. Public slug in the install URL (github.com/apps/<slug>). Not a secret.
GITHUB_APP_SLUG=
# Launcher only. scripts/adamant forwards this smee.io channel (curl -sI https://smee.io/new)
# to the local API so GitHub webhooks reach a laptop. Set the App's webhook URL to it.
ADAMANT_WEBHOOK_PROXY_URL=
# OAuth
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8787/auth/github/callback

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8787/auth/google/callback

# Worker only. What the sandbox runs against a candidate. Install may reach the
# network; the test command never does.
ADAMANT_SANDBOX_IMAGE=node:22-bookworm-slim
ADAMANT_SANDBOX_INSTALL=npm ci --no-audit --no-fund
ADAMANT_SANDBOX_TEST=npm test
# Python repositories get their own profile (venv + pytest); `fixed` always uses the three above.
# ADAMANT_SANDBOX_PROFILE=fixed
# The heal's model steps: `agents` (OpenAI Agents SDK, explores and tries fixes) or `classic`.
# ADAMANT_HEAL_AGENT=agents
# Worker only. Heals in flight per worker process.
ADAMANT_WORKER_CONCURRENCY=2
# Worker only. Run worktrees. In Compose this is bind-mounted at the same path
# on the host, because the host's Docker daemon mounts it into the sandbox.
ADAMANT_WORKSPACE_ROOT=/tmp/adamant-workspaces
# Worker only. Package caches (npm, pnpm, yarn, pip), one directory per
# repository, mounted into the install container only. Default is
# <ADAMANT_WORKSPACE_ROOT>/.cache; `none` turns them off. A cache no install
# has used for this many days is removed when the worker boots.
# ADAMANT_SANDBOX_CACHE_ROOT=
# ADAMANT_SANDBOX_CACHE_MAX_AGE_DAYS=14
# Compose only. Group that owns /var/run/docker.sock on the host.
DOCKER_GID=0
