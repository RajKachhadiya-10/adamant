{
  "name": "@adamant/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../.env --experimental-strip-types --watch api/index.ts",
    "dev:worker": "node --env-file-if-exists=../.env --experimental-strip-types --watch worker/index.ts",
    "start": "node --env-file-if-exists=../.env --experimental-strip-types api/index.ts",
    "start:worker": "node --env-file-if-exists=../.env --experimental-strip-types worker/index.ts",
    "session:create": "node --env-file-if-exists=../.env --experimental-strip-types api/create-session.ts",
    "test": "node --experimental-strip-types --test ../tests/api/*.test.ts ../tests/agent/*.test.ts ../tests/sandbox/*.test.ts ../tests/db/*.test.ts ../tests/worker/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "drizzle-kit generate --config db/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config db/drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config db/drizzle.config.ts"
  },
  "dependencies": {
    "@adamant/contract": "workspace:*",
    "@hono/node-server": "^2.1.5",
    "@langchain/core": "^1.3.2",
    "@langchain/langgraph": "^1.5.3",
    "@langchain/langgraph-checkpoint": "^1.2.1",
    "@langchain/langgraph-checkpoint-postgres": "^1.1.2",
    "@openai/agents": "^0.21.0",
    "drizzle-orm": "^0.45.4",
    "graphile-worker": "^0.18.0",
    "hono": "^4.13.14",
    "openai": "^7.45.1",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11"
  }
}
